{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "~img/*": [
        "src/assets/images/*"
      ],
      "@style/*": [
        "src/style/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    }
  }
}
